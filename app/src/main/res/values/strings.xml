    <!-- ===== Panduan ===== -->
    <string name="guide_open">Buka panduan lengkap</string>
    <string name="guide_title">Panduan aktivasi</string>
    <string name="guide_intro">Ikuti lima langkah berikut. Setelah selesai, Anda bisa dikte dan memanggil asisten dari aplikasi mana pun.</string>
    <string name="guide_step_label">Langkah</string>
    <string name="guide_step1_title">Pilih keyboard Retrobit</string>
    <string name="guide_step1_body">Buka pemilih keyboard lalu pilih \"Retrobit Voice\". Anda bisa kembali ke keyboard lama kapan pun lewat tombol keyboard di bar Retrobit.</string>
    <string name="guide_step2_title">Aktifkan layanan aksesibilitas</string>
    <string name="guide_step2_body">Cari \"Retrobit Voice — tempel otomatis\" di daftar layanan terpasang lalu aktifkan. Ini yang membuat teks menempel sendiri tanpa membuka keyboard.</string>
    <string name="guide_step3_title">Izinkan bubble melayang</string>
    <string name="guide_step3_body">Aktifkan \"Tampil di atas aplikasi lain\" agar tombol mikrofon selalu bisa dipanggil.</string>
    <string name="guide_step4_title">Jadikan asisten bawaan (opsional)</string>
    <string name="guide_step4_body">Dengan ini, tekan lama tombol Home langsung membuka Retrobit dan mulai mendengarkan.</string>
    <string name="guide_step5_title">Rawat daya baterai</string>
    <string name="guide_step5_body">Matikan optimasi baterai untuk Retrobit supaya rekaman dan kata kunci tidak terputus saat layar mati.</string>
    <string name="guide_tips_title">Tips &amp; catatan privasi</string>
    <string name="guide_tip_battery">Perekaman dibatasi otomatis (maksimal 3 menit) dan berhenti saat Anda diam.</string>
    <string name="guide_tip_offline">Mode on-device bekerja tanpa internet sama sekali — cocok untuk catatan pribadi.</string>
    <string name="guide_tip_privacy">Audio dihapus segera setelah transkripsi bila Anda memakai mesin on-device.</string>
    <string name="guide_tip_llm">Asisten daring hanya aktif kalau Anda memasukkan API key Anda sendiri.</string>
    <string name="guide_open_settings">Buka pengaturan aplikasi</string>
    <string name="guide_refresh_status">Perbarui status mesin</string>

