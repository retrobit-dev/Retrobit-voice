    <string name="guide_open">Open full guide</string>
    <string name="guide_title">Activation guide</string>
    <string name="guide_intro">Follow these five steps. Afterwards you can dictate and summon the assistant from any app.</string>
    <string name="guide_step_label">Step</string>
    <string name="guide_step1_title">Choose the Retrobit keyboard</string>
    <string name="guide_step1_body">Open the keyboard picker and choose \"Retrobit Voice\". You can switch back anytime with the keyboard button in the Retrobit bar.</string>
    <string name="guide_step2_title">Enable the accessibility service</string>
    <string name="guide_step2_body">Find \"Retrobit Voice — auto paste\" in the installed services list and enable it. This is what lets text paste itself without the keyboard.</string>
    <string name="guide_step3_title">Allow the floating bubble</string>
    <string name="guide_step3_body">Enable \"Display over other apps\" so the mic button is always reachable.</string>
    <string name="guide_step4_title">Set as default assistant (optional)</string>
    <string name="guide_step4_body">Then a long-press of Home opens Retrobit and starts listening.</string>
    <string name="guide_step5_title">Battery care</string>
    <string name="guide_step5_body">Disable battery optimization for Retrobit so recording and the wake word survive screen-off.</string>
    <string name="guide_tips_title">Tips &amp; privacy notes</string>
    <string name="guide_tip_battery">Recording is capped (3 minutes max) and stops when you go quiet.</string>
    <string name="guide_tip_offline">On-device mode works with no internet at all — great for private notes.</string>
    <string name="guide_tip_privacy">Audio is deleted right after transcription when you use an on-device engine.</string>
    <string name="guide_tip_llm">Online assistant features activate only with your own API key.</string>
    <string name="guide_open_settings">Open app settings</string>
    <string name="guide_refresh_status">Refresh engine status</string>

